# ---- Database -------------------------------------------------------------
# Local dev (docker compose): postgresql://vigil:vigil@localhost:5433/vigil
# Production: Neon POOLED connection string (must include sslmode=require)
DATABASE_URL=postgresql://vigil:vigil@localhost:5433/vigil

# ---- LLM (Gemini free tier) -------------------------------------------------
# Leave GEMINI_API_KEY empty to run fully offline (LLM_MODE=auto falls back to
# recorded fixtures). Get a key at https://aistudio.google.com/apikey (no card).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
LLM_MODE=auto                # auto | gemini | fake
LLM_DAILY_BUDGET=200         # generation calls/day; hard stop (free tier ~250 RPD)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768           # Matryoshka truncation; vectors L2-normalized in code
EMBEDDINGS_MODE=auto         # auto | gemini | fake (fake = deterministic hash vectors)

# ---- GitHub (commit analysis target) ---------------------------------------
GITHUB_MODE=fixture          # fixture (offline, default) | live
# optional fine-grained PAT, read-only Contents
GITHUB_TOKEN=

# ---- Slack ------------------------------------------------------------------
SLACK_MODE=mock              # mock (console+dashboard, default) | webhook
# Incoming Webhook URL (SLACK_MODE=webhook)
SLACK_WEBHOOK_URL=
# optional xoxb- token; enables chat.postMessage + threaded postmortems
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents     # used only with SLACK_BOT_TOKEN
# Slack app signing secret (resolve button)
SLACK_SIGNING_SECRET=

# ---- Auth tokens ------------------------------------------------------------
ALERTMANAGER_WEBHOOK_TOKEN=dev-token   # bearer for POST /webhooks/alertmanager
RESUME_TOKEN=dev-token                 # bearer for the operator endpoints: resume, resolve, delete

# ---- Misc -------------------------------------------------------------------
DASHBOARD_URL=http://localhost:5173
SERVICES_FILE=services.yaml
COMMIT_LOOKBACK_HOURS=48
